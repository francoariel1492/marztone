# ── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Database (PostgreSQL) ───────────────────────────
DATABASE_URL="postgresql://marztone:marztone@localhost:5432/marztone?schema=public"

# ── JWT ─────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Seguridad login ─────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# ── Admin inicial (seed) ────────────────────────────
ADMIN_EMAIL=admin@marztone.com
ADMIN_INITIAL_PASSWORD=ChangeMe123!

# ── SMTP / Email ────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MarzTone Website <no-reply@marztone.com>"
MAIL_TO=contacto@marztone.com

# ── Storage ─────────────────────────────────────────
# local | cloudinary
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_URL=http://localhost:3000/uploads
MAX_FILE_SIZE_MB=5

# Cloudinary (producción)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
